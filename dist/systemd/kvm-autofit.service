[Unit]
Description=Fit X displays to the KVM host window (kvm-autofit, rust)
Documentation=file:///usr/local/share/doc/kvm-autofit/README.md
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/kvm-autofit watch
Restart=on-failure
RestartSec=2s

# Least privilege. Root is needed only to read other users' /proc entries and X
# cookies; every other root power is dropped.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=
NoNewPrivileges=yes
# Filesystem: read-only everywhere except /run (lock file). /tmp must stay shared:
# that is where the X sockets live (/tmp/.X11-unix).
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run
PrivateTmp=no
PrivateDevices=yes
UMask=0077
# Kernel / system surfaces it never touches.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# Sockets: X (unix), journal (unix), uevents (netlink) - nothing else, no network.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @module @raw-io @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
